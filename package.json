{
  "name": "xiaohe-shuangpin-trainer",
  "version": "0.0.0",
  "private": true,
  "description": "小鹤双拼离线学习器与独立 Agent 协调器",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @xiaohe/trainer",
    "dev": "npm run dev --workspace @xiaohe/trainer",
    "test": "npm run test --workspace @xiaohe/trainer",
    "typecheck": "npm run typecheck --workspace @xiaohe/trainer",
    "verify:ui": "node scripts/verify-ui.mjs",
    "showcase": "node scripts/record-showcase.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:all": "npm run test --workspace @xiaohe/trainer && npm run test --workspace @xiaohe/coordinator",
    "coord": "npm run coord --workspace @xiaohe/coordinator"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.64.1"
  }
}
